# Google OAuth credentials (optional bootstrap defaults).
# If omitted, set them on first launch in /setup; values persist in DB.
# Get these from https://console.developers.google.com/
# Leave these commented out to use /setup: any value here, even a placeholder,
# is stored in a new database and counts as configured.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: Clever OAuth credentials (for Clever login). Same rule: leave them
# commented out unless you have real ones.
# CLEVER_CLIENT_ID=
# CLEVER_CLIENT_SECRET=
# Optional: override Clever redirect URI (otherwise derived from request host)
# CLEVER_REDIRECT_URI=https://your-domain.example/auth/clever/callback

# Session secret (generate a random string for production)
SESSION_SECRET=

# Database path (SQLite)
DATABASE_URL=./data/flashcards.db

# Server port
PORT=6767

# Optional: frontend origin for OAuth redirect targets (useful for remote dev)
# FRONTEND_URL=https://dev.example.org
# Optional: frontend port when FRONTEND_URL is not set in non-production
# FRONTEND_PORT=5173
# Optional, development: host names the Vite dev server accepts besides localhost
# and IP addresses (comma-separated), e.g. when it sits behind a proxy at FRONTEND_URL
# VITE_ALLOWED_HOSTS=dev.example.org

# Required for first sign-in: initial admin email (auto-promoted)
ADMIN_EMAIL=admin@example.com

# Optional: disable legacy one-time migration ledger backfill once all
# deployments have migrated cleanly using Drizzle migrations.
# ENABLE_LEGACY_MIGRATION_BACKFILL=false

# Redis (session store): used in production, or in development with REQUIRE_REDIS=true;
# otherwise sessions are kept in memory.
REDIS_URL=redis://localhost:6379

# Optional: require Redis in development too (production always requires Redis)
REQUIRE_REDIS=false

# AI defaults: read ONCE, when the database has no settings yet (a new install),
# like the Google and Clever credentials above. After that, change them in the
# admin panel (Admin > AI); editing this file does nothing.
# (docker-compose*.yml pass only the variables they list.)
AI_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Anthropic (Claude) for mnemonic suggestions only. Bootstrap only: seeds a NEW database; on an existing install paste the key in Admin > AI.
ANTHROPIC_API_KEY=
AI_TEXT_PROVIDER=openai
AI_PRONUNCIATION_ENABLED=true
AI_IMAGE_ENABLED=true
AI_MNEMONIC_ENABLED=true
# Example models (the docker-compose*.yml defaults); with neither set, the code
# seeds gpt-4.1 and gpt-image-1.
AI_MNEMONIC_MODEL=gpt-5.2
AI_IMAGE_MODEL=gpt-image-1.5
AI_IMAGE_QUALITY=low

# More AI defaults (new database only, as above)
# AI_TTS_PROVIDER=openai
# AI_TTS_MODEL=gpt-4o-mini-tts
# AI_TTS_VOICE_MAP={}
# ELEVENLABS_API_KEY=
# Vocabulómetro voice (later set in Admin > Vocabulómetro)
# VOCAB_TTS_VOICE_ID=

# Optional: key for the secrets stored in app_settings (else SESSION_SECRET is
# used). Changing it, or SESSION_SECRET when this is unset, makes stored keys unreadable.
# APP_SETTINGS_ENCRYPTION_KEY=

# Optional: Express "trust proxy" (default 1 in production, off in development)
# TRUST_PROXY=1

# Optional: session cookie flags. Secure is on in production (and with SameSite=none);
# set SESSION_COOKIE_SECURE=false only for plain http.
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_SAMESITE=lax

# Optional, development without FRONTEND_URL: hosts trusted as the frontend for
# sign-in redirects (comma-separated)
# ALLOWED_REDIRECT_HOSTS=

# Optional: hide Clever sign-in without deleting its credentials
# CLEVER_AUTH_DISABLED=true
# Optional: override the Clever roster redirect URI (otherwise derived from request host)
# CLEVER_ROSTER_REDIRECT_URI=https://your-domain.example/auth/clever/roster/callback

# Optional: the school network's public IP addresses (comma-separated). PIN sign-in's
# Auto mode counts only Google sign-in attempts from these addresses (a student's
# successful sign-in from anywhere still clears it). Empty or unset: in production,
# Auto mode never switches PIN sign-in on (On and Off still work); in development,
# only loopback counts.
# PIN_AUTO_SCHOOL_IPS=

# Optional: folder of userscripts served at /tools; a copy there wins when its
# @version is higher (default ./data/tools)
# USERSCRIPTS_DIR=

# Optional: pino log level (default info in production, debug otherwise)
# LOG_LEVEL=info

# Optional: the operator's name and contacts for the legal pages (/privacy, /privacy/summary,
# /terms, /subprocessors, /privacy/coppa-notice) and /.well-known/security.txt. The pages are
# neutral defaults that tell readers the operator has not published its own texts yet, and
# state only what the software does and which AI features are on; publish your own as
# doc/legal-documents.md describes. Unset, a page says "[not yet stated]" and names nobody.
# With Docker Compose, list them (like any other variable here) under the app's environment:
# in your untracked host override, writing a literal $ as $$.
# LEGAL_OPERATOR_LEGAL_NAME=Example Learning, Inc.
# LEGAL_OPERATOR_SHORT_NAME=Example Learning
# LEGAL_SERVICE_DOMAIN=learn.example.org
# LEGAL_SUPPORT_EMAIL=support@example.org
# LEGAL_PRIVACY_EMAIL=privacy@example.org
# LEGAL_SECURITY_EMAIL=security@example.org
# LEGAL_OPERATOR_POSTAL_ADDRESS=
# LEGAL_OPERATOR_PHONE=
# LEGAL_SOURCE_URL=

# Optional: key for the one-way hashes the logs keep of PIN usernames and teachers'
# emails (else derived from SESSION_SECRET). Set one if you may rotate SESSION_SECRET.
# LOG_HASH_KEY=

# Optional: the record of deletions made with dist/db/deleteUser.js (default
# data/deletions.jsonl), and the key of its email hashes (default: a key file made
# beside it on the first deletion). Back both up; never change the key.
# DELETION_LEDGER=data/deletions.jsonl
# DELETION_LEDGER_KEY=
