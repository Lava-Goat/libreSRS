{
  "name": "@libresrs/server",
  "version": "1.26.2",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node scripts/copy-legal-templates.mjs && ../../scripts/write-build-info.sh ./dist",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "test": "vitest run",
    "test:fsrs-scan": "FSRS_SCAN_EXISTING_DB=1 vitest run src/services/fsrs_db_scan.test.ts"
  },
  "dependencies": {
    "@libresrs/shared": "*",
    "@trpc/server": "^11.9.0",
    "better-sqlite3": "^13.0.3",
    "connect-redis": "^9.0.0",
    "cors": "^2.8.6",
    "dompurify": "^3.3.1",
    "dotenv": "^17.2.4",
    "drizzle-orm": "^0.45.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.19.0",
    "jsdom": "^28.0.0",
    "papaparse": "^5.5.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pino": "^10.3.0",
    "redis": "^5.10.0",
    "ts-fsrs": "^5.2.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/jsdom": "^27.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "drizzle-kit": "^0.31.9",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
