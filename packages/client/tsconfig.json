{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@libresrs/server-extensions": ["../server/src/extensions/enabled.ts", "../server/src/extensions/none.ts"],
      "@libresrs/client-extensions": ["./src/extensions/enabled.tsx", "./src/extensions/none.tsx"]
    },
    "moduleResolution": "bundler",
    "types": ["vitest/globals", "@testing-library/jest-dom", "passport", "express-session", "vite/client"]
  },
  "include": ["src/**/*"],
  "references": [
    { "path": "../shared" }
  ]
}
